# Motto Otto - Einstellungen (Umgebungsvariablen)
# Nur die NAMEN stehen hier, nie echte Werte. Die echten Werte liegen bei Railway
# (Projekt kiez-design-api, Dienst motto-otto, Reiter "Variables").
# Fuer einen lokalen Start: diese Datei nach .env kopieren und Werte eintragen -
# die .env selbst wird nie ins Repository geladen.

# --- Pflicht fuer einen Start ---
PORT=
PUBLIC_BASE_URL=
ADMIN_TOKEN=
MASTER_TOKEN=
SIGN_SECRET=
BALLZ_MCP_URL=

# --- KI (Texte lesen, Bildpruefung) ---
OPENAI_API_KEY=
QA_MODEL=

# --- E-Mail (Brevo) ---
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
ADMIN_EMAIL=
ADMIN_MAIL=
DESIGN_MAIL=
DESIGN_MAIL_AN=
SPERR_MAIL=
INTERNE_MAILS=
WIDERRUF_MAIL=

# --- Bezahlen und Shop ---
STRIPE_SECRET_KEY=
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=
SHOPIFY_KASSE=

# --- Druckdienstleister (Print on Demand) ---
POD_PROVIDER=
GELATO_API_KEY=
PRINTFUL_API_KEY=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# --- Google Drive (Ablage der Druckdateien) ---
